						"text": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\n                WELCOME TO FERENTARIARK ASCENDED\r\n\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\nFirst of all, thank you for choosing to spend your time with us.\r\n\r\nFerentariArK isn't just another server that appeared overnight.\r\nOur community was built over years on ARK: Survival Evolved, where\r\nhundreds of players created unforgettable memories, rivalries,\r\nalliances, and legendary raids.\r\n\r\nWhen ARK: Survival Ascended released, we didn't simply start over.\r\n\r\nWe brought our experience, our community, and our passion with us.\r\n\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\nOUR PHILOSOPHY\r\n\r\nToo many servers open with big promises only to disappear after a\r\nfew weeks or wipe every month.\r\n\r\nThat's not who we are.\r\n\r\nFerentariArK is designed to be a long-term home for players who\r\nwant their progress to matter.\r\n\r\nEvery base you build.\r\nEvery creature you tame.\r\nEvery war you fight.\r\nEvery friendship and rivalry you create.\r\n\r\nIt all becomes part of the server's history.\r\n\r\nWe're here for the long run.\r\n\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\nWHAT YOU CAN EXPECT\r\n\r\n✓ Long-Term No Wipe Progression\r\n\r\nBuild without worrying about losing months of work because of\r\nscheduled wipes.\r\n\r\n✓ Experienced Administration\r\n\r\nWe've been managing ARK communities since Survival Evolved.\r\nWe understand what players expect from a quality server and we're\r\nalways working to improve the experience.\r\n\r\n✓ Community First\r\n\r\nEvery update, event, balance adjustment and decision is made with\r\nthe community in mind. We actively listen to feedback because the\r\nbest servers are built together with their players.\r\n\r\n✓ Fair Competitive PvP\r\n\r\nWhether you're a solo survivor or a large tribe, our goal is to\r\ncreate a balanced environment where strategy, teamwork and skill\r\nmatter more than unfair advantages.\r\n\r\n✓ Stable Dedicated Hardware\r\n\r\nHigh-performance hosting means better stability, smoother gameplay\r\nand a server you can rely on every day.\r\n\r\n✓ Continuous Development\r\n\r\nFerentariArK will continue growing with new maps, events, quality\r\nof life improvements and new features as ARK: Survival Ascended\r\nevolves.\r\n\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\nOUR PROMISE\r\n\r\nWe're investing our time and resources into building something\r\nthat lasts.\r\n\r\nThis isn't a temporary project.\r\n\r\nThis isn't a server that disappears after the hype fades.\r\n\r\nOur goal is to create one of the best long-term ARK Survival\r\nAscended communities, where players can always return knowing\r\ntheir progress is still here.\r\n\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\nGET STARTED\r\n\r\nF1 = Server Shop\r\n\r\nF2 = Server Information, Rates & Discord\r\n\r\nJoin our Discord to stay informed about updates, events,\r\ngiveaways, announcements and community discussions.\r\n\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\nThank you for becoming part of the next chapter of FerentariArK.\r\n\r\nWe hope you'll build unforgettable memories here,\r\njust like thousands of hours of memories were made during the\r\nSurvival Evolved era.\r\n\r\nGood luck, Survivor.\r\n\r\nWelcome home.\r\n\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
